@page "/orders"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using LaundryManagement.Blazor.Models
@using LaundryManagement.Blazor.Services
@inject IHttpClientFactory HttpClientFactory
@inject AuthService AuthService

<PageTitle>Orders</PageTitle>

<h1>Orders</h1>
<p class="lead">Create and manage customer laundry orders</p>

<div class="card mb-4">
    <div class="card-body">
        <h4>Create Order</h4>

        <div class="mb-3">
            <label class="form-label">Customer</label>

            <select class="form-select" @bind="newOrder.CustomerId">
                <option value="0">Select customer</option>

                @foreach (var customer in customers)
                {
                    <option value="@customer.Id">
                        @customer.Name
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Collection Date</label>

            <input type="datetime-local"
                   class="form-control"
                   @bind="newOrder.CollectionDate" />
        </div>

        <button class="btn btn-primary"
                @onclick="CreateOrder">
            Create Order
        </button>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-info mt-3">
                @message
            </div>
        }
    </div>
</div>

<h3>Current Orders</h3>

@if (loading)
{
    <p>Loading orders...</p>
}
else if (orders.Count == 0)
{
    <p>No orders found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Collection</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in orders.OrderByDescending(o => o.OrderDate))
                {
                    <tr>
                        <td>#@order.Id</td>

                        <td>@order.CustomerName</td>

                        <td>
                            <span class="badge bg-secondary">
                                @order.Status
                            </span>
                        </td>

                        <td>
                            @(order.CollectionDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>

                        <td>
                            €@order.TotalPrice.ToString("0.00")
                        </td>

                        <td>
                            <button class="btn btn-sm btn-primary me-2"
                                    @onclick="() => ManageItems(order)">
                                Items
                            </button>

                            <button class="btn btn-sm btn-secondary me-2"
                                    @onclick="() => StartEdit(order)">
                                Edit
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => DeleteOrder(order.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (selectedOrder != null)
{
    <div class="card mt-4">
        <div class="card-body">

            <h4>Order #@selectedOrder.Id Items</h4>
            <p>
                Customer: <strong>@selectedOrder.CustomerName</strong>
            </p>

            <div class="row mb-3">

                <div class="col-md-5">
                    <label class="form-label">Service</label>

                    <select class="form-select" @bind="newItem.ServiceId">
                        <option value="0">Select service</option>

                        @foreach (var service in services)
                        {
                            <option value="@service.Id">
                                @service.Name - €@service.Price.ToString("0.00")
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Quantity</label>

                    <input type="number"
                           min="1"
                           class="form-control"
                           @bind="newItem.Quantity" />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-success"
                            @onclick="AddOrderItem">
                        Add Item
                    </button>
                </div>

            </div>

            @if (selectedOrderItems.Count == 0)
            {
                <p>No items added to this order.</p>
            }
            else
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in selectedOrderItems)
                        {
                            <tr>
                                <td>@item.ServiceName</td>

                                <td>
                                    €@item.Price.ToString("0.00")
                                </td>

                                <td style="width: 150px;">
                                    <input type="number"
                                           min="1"
                                           class="form-control form-control-sm"
                                           value="@item.Quantity"
                                           @onchange="e => UpdateItemQuantity(item, e)" />
                                </td>

                                <td>
                                    €@item.Subtotal.ToString("0.00")
                                </td>

                                <td>
                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => DeleteOrderItem(item.Id)">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="text-end">
                <h4>
                    Order Total:
                    €@selectedOrder.TotalPrice.ToString("0.00")
                </h4>
            </div>

            <button class="btn btn-secondary"
                    @onclick="CloseItems">
                Close
            </button>

        </div>
    </div>
}

@if (editingOrder != null)
{
    <div class="card mt-4">
        <div class="card-body">

            <h4>Edit Order #@editingOrder.Id</h4>

            <div class="mb-3">
                <label class="form-label">Customer</label>

                <input class="form-control"
                       value="@editingOrder.CustomerName"
                       disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>

                <select class="form-select"
                        @bind="editStatus">

                    <option value="Pending">Pending</option>
                    <option value="Processing">Processing</option>
                    <option value="Ready">Ready</option>
                    <option value="Collected">Collected</option>

                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Collection Date</label>

                <input type="datetime-local"
                       class="form-control"
                       @bind="editCollectionDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">Current Total</label>

                <input class="form-control"
                       value="@($"€{editingOrder.TotalPrice:0.00}")"
                       disabled />
            </div>

            <button class="btn btn-primary me-2"
                    @onclick="SaveEdit">
                Save Changes
            </button>

            <button class="btn btn-secondary"
                    @onclick="CancelEdit">
                Cancel
            </button>

        </div>
    </div>
}

@code {

    private List<OrderDto> orders = new();
    private List<CustomerDto> customers = new();
    private List<ServiceDto> services = new();
    private List<OrderItemDto> orderItems = new();

    private CreateOrderRequest newOrder = new();

    private OrderDto? editingOrder;
    private string editStatus = string.Empty;
    private DateTime? editCollectionDate;

    private OrderDto? selectedOrder;
    private List<OrderItemDto> selectedOrderItems = new();

    private CreateOrderItemRequest newItem = new()
    {
        Quantity = 1
    };

    private bool loading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var client =
                HttpClientFactory.CreateClient("LaundryApi");

            customers =
                await client.GetFromJsonAsync<List<CustomerDto>>(
                    "api/customers") ?? new();

            orders =
                await client.GetFromJsonAsync<List<OrderDto>>(
                    "api/orders") ?? new();

            services =
                await client.GetFromJsonAsync<List<ServiceDto>>(
                    "api/services") ?? new();

            orderItems =
                await client.GetFromJsonAsync<List<OrderItemDto>>(
                    "api/orderitems") ?? new();

            if (selectedOrder != null)
            {
                RefreshSelectedOrder();
            }
        }
        catch
        {
            message = "Could not load order data.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreateOrder()
    {
        message = null;

        if (newOrder.CustomerId <= 0)
        {
            message = "Please select a customer.";
            return;
        }

        try
        {
            var client =
                AuthService.CreateAuthenticatedClient();

            var response =
                await client.PostAsJsonAsync(
                    "api/orders",
                    newOrder);

            if (response.IsSuccessStatusCode)
            {
                message = "Order created successfully.";

                newOrder = new CreateOrderRequest();

                await LoadData();
            }
            else
            {
                message =
                    $"Order could not be created. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }

    private void ManageItems(OrderDto order)
    {
        selectedOrder = order;

        selectedOrderItems =
            orderItems
                .Where(item => item.OrderId == order.Id)
                .ToList();

        newItem = new CreateOrderItemRequest
        {
            OrderId = order.Id,
            Quantity = 1
        };

        editingOrder = null;
    }

    private void CloseItems()
    {
        selectedOrder = null;
        selectedOrderItems = new();
    }

    private async Task AddOrderItem()
    {
        if (selectedOrder == null)
        {
            return;
        }

        if (newItem.ServiceId <= 0)
        {
            message = "Please select a service.";
            return;
        }

        if (newItem.Quantity <= 0)
        {
            message = "Quantity must be at least 1.";
            return;
        }

        newItem.OrderId = selectedOrder.Id;

        try
        {
            var client =
                AuthService.CreateAuthenticatedClient();

            var response =
                await client.PostAsJsonAsync(
                    "api/orderitems",
                    newItem);

            if (response.IsSuccessStatusCode)
            {
                message = "Item added to order.";

                newItem = new CreateOrderItemRequest
                {
                    OrderId = selectedOrder.Id,
                    Quantity = 1
                };

                await LoadData();
            }
            else
            {
                message =
                    $"Item could not be added. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }

    private async Task UpdateItemQuantity(
        OrderItemDto item,
        ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var quantity))
        {
            return;
        }

        if (quantity <= 0)
        {
            message = "Quantity must be at least 1.";
            return;
        }

        try
        {
            var client =
                AuthService.CreateAuthenticatedClient();

            var response =
                await client.PutAsJsonAsync(
                    $"api/orderitems/{item.Id}",
                    new
                    {
                        Quantity = quantity
                    });

            if (response.IsSuccessStatusCode)
            {
                message = "Item quantity updated.";

                await LoadData();
            }
            else
            {
                message =
                    $"Item could not be updated. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }

    private async Task DeleteOrderItem(int id)
    {
        try
        {
            var client =
                AuthService.CreateAuthenticatedClient();

            var response =
                await client.DeleteAsync(
                    $"api/orderitems/{id}");

            if (response.IsSuccessStatusCode)
            {
                message = "Item removed from order.";

                await LoadData();
            }
            else
            {
                message =
                    $"Item could not be removed. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }

    private void RefreshSelectedOrder()
    {
        if (selectedOrder == null)
        {
            return;
        }

        var refreshedOrder =
            orders.FirstOrDefault(
                order => order.Id == selectedOrder.Id);

        if (refreshedOrder == null)
        {
            selectedOrder = null;
            selectedOrderItems = new();
            return;
        }

        selectedOrder = refreshedOrder;

        selectedOrderItems =
            orderItems
                .Where(item => item.OrderId == selectedOrder.Id)
                .ToList();
    }

    private void StartEdit(OrderDto order)
    {
        editingOrder = order;

        editStatus = order.Status;
        editCollectionDate = order.CollectionDate;

        selectedOrder = null;
    }

    private void CancelEdit()
    {
        editingOrder = null;
        editStatus = string.Empty;
        editCollectionDate = null;
    }

    private async Task SaveEdit()
    {
        if (editingOrder == null)
        {
            return;
        }

        try
        {
            var client =
                AuthService.CreateAuthenticatedClient();

            var updateRequest = new UpdateOrderRequest
            {
                Status = editStatus,
                CollectionDate = editCollectionDate
            };

            var response =
                await client.PutAsJsonAsync(
                    $"api/orders/{editingOrder.Id}",
                    updateRequest);

            if (response.IsSuccessStatusCode)
            {
                message = "Order updated successfully.";

                editingOrder = null;

                await LoadData();
            }
            else
            {
                message =
                    $"Order could not be updated. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }

    private async Task DeleteOrder(int id)
    {
        try
        {
            var client =
                AuthService.CreateAuthenticatedClient();

            var response =
                await client.DeleteAsync(
                    $"api/orders/{id}");

            if (response.IsSuccessStatusCode)
            {
                message = "Order deleted.";

                if (editingOrder?.Id == id)
                {
                    editingOrder = null;
                }

                if (selectedOrder?.Id == id)
                {
                    selectedOrder = null;
                    selectedOrderItems = new();
                }

                await LoadData();
            }
            else
            {
                message =
                    $"Order could not be deleted. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }

    private class CreateOrderRequest
    {
        public int CustomerId { get; set; }

        public DateTime? CollectionDate { get; set; }
    }

    private class UpdateOrderRequest
    {
        public string Status { get; set; } = string.Empty;

        public DateTime? CollectionDate { get; set; }
    }

    private class CreateOrderItemRequest
    {
        public int OrderId { get; set; }

        public int ServiceId { get; set; }

        public int Quantity { get; set; }
    }
}