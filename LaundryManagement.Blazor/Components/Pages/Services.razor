@page "/services"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using LaundryManagement.Blazor.Models
@using LaundryManagement.Blazor.Services
@inject IHttpClientFactory HttpClientFactory
@inject AuthService AuthService

<PageTitle>Services</PageTitle>

<h1>Services</h1>
<p class="lead">Manage laundry services and prices</p>

<div class="card mb-4">
    <div class="card-body">
        <h4>Add Service</h4>

        <div class="mb-3">
            <label class="form-label">Service Name</label>
            <input class="form-control" @bind="newService.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <input class="form-control" @bind="newService.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Price (€)</label>
            <input type="number"
                   step="0.01"
                   class="form-control"
                   @bind="newService.Price" />
        </div>

        <button class="btn btn-primary" @onclick="AddService">
            Add Service
        </button>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-info mt-3">
                @message
            </div>
        }
    </div>
</div>

<h3>Available Services</h3>

@if (loading)
{
    <p>Loading services...</p>
}
else if (services.Count == 0)
{
    <p>No services found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Service</th>
                <th>Description</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var service in services)
            {
                <tr>
                    <td>@service.Name</td>
                    <td>@service.Description</td>
                    <td>€@service.Price.ToString("0.00")</td>
                    <td>
                        <button class="btn btn-sm btn-secondary me-2"
                                @onclick="() => StartEdit(service)">
                            Edit
                        </button>

                        <button class="btn btn-sm btn-danger"
                                @onclick="() => DeleteService(service.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (editingService != null)
{
    <div class="card mt-4">
        <div class="card-body">
            <h4>Edit Service</h4>

            <div class="mb-3">
                <label class="form-label">Service Name</label>
                <input class="form-control"
                       @bind="editingService.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <input class="form-control"
                       @bind="editingService.Description" />
            </div>

            <div class="mb-3">
                <label class="form-label">Price (€)</label>
                <input type="number"
                       step="0.01"
                       class="form-control"
                       @bind="editingService.Price" />
            </div>

            <button class="btn btn-primary me-2"
                    @onclick="SaveEdit">
                Save Changes
            </button>

            <button class="btn btn-secondary"
                    @onclick="CancelEdit">
                Cancel
            </button>
        </div>
    </div>
}

@code {
    private List<ServiceDto> services = new();
    private ServiceDto newService = new();
    private ServiceDto? editingService;

    private bool loading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadServices();
    }

    private async Task LoadServices()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("LaundryApi");

            services =
                await client.GetFromJsonAsync<List<ServiceDto>>(
                    "api/services") ?? new();
        }
        catch
        {
            message = "Could not load services.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AddService()
    {
        message = null;

        try
        {
            var client = AuthService.CreateAuthenticatedClient();

            var response = await client.PostAsJsonAsync(
                "api/services",
                newService);

            if (response.IsSuccessStatusCode)
            {
                message = "Service added successfully.";
                newService = new ServiceDto();

                await LoadServices();
            }
            else
            {
                message =
                    $"Service could not be added. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }

    private void StartEdit(ServiceDto service)
    {
        editingService = new ServiceDto
        {
            Id = service.Id,
            Name = service.Name,
            Description = service.Description,
            Price = service.Price
        };
    }

    private void CancelEdit()
    {
        editingService = null;
    }

    private async Task SaveEdit()
    {
        if (editingService == null)
        {
            return;
        }

        try
        {
            var client = AuthService.CreateAuthenticatedClient();

            var response = await client.PutAsJsonAsync(
                $"api/services/{editingService.Id}",
                editingService);

            if (response.IsSuccessStatusCode)
            {
                message = "Service updated successfully.";
                editingService = null;

                await LoadServices();
            }
            else
            {
                message =
                    $"Service could not be updated. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }

    private async Task DeleteService(int id)
    {
        try
        {
            var client = AuthService.CreateAuthenticatedClient();

            var response =
                await client.DeleteAsync($"api/services/{id}");

            if (response.IsSuccessStatusCode)
            {
                message = "Service deleted.";
                await LoadServices();
            }
            else
            {
                message =
                    $"Service could not be deleted. Status: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch
        {
            message = "Could not connect to the API.";
        }
    }
}